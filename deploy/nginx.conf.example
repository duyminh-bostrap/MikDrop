# Ví dụ dùng nginx làm reverse proxy cho MikDrop (chạy MikDrop với TRUST_PROXY=1, cổng 3000).
# Cấp chứng chỉ bằng certbot: sudo certbot --nginx -d mikdrop.example.com

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

server {
    listen 80;
    server_name mikdrop.example.com;

    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;

        # WebSocket cho Socket.io
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;

        proxy_set_header Host $host;
        # nginx nối IP thiết bị vào cuối X-Forwarded-For; MikDrop lấy phần tử cuối (PROXY_HOPS=1)
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # Chế độ dự phòng chuyển tiếp mảnh tệp qua server và đo tốc độ tải lên: không đệm, không giới hạn kích thước
        proxy_buffering off;
        proxy_request_buffering off;
        client_max_body_size 0;
        proxy_read_timeout 3600s;
    }
}
